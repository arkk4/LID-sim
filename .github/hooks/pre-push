#!/bin/sh
set -e

# Guard hook: ensure version and branding assets are committed and in sync before pushing to main
TARGET_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$TARGET_BRANCH" = "main" ]; then
  # 1. Verify version.json and package.json versions match
  V_VER=$(node -e "console.log(require('./version.json').version)")
  P_VER=$(node -e "console.log(require('./package.json').version)")

  if [ "$V_VER" != "$P_VER" ]; then
    echo "❌ [pre-push] version.json ($V_VER) and package.json ($P_VER) are out of sync."
    echo "   Run 'make bump' to synchronize and commit versions."
    exit 1
  fi

  # 2. Check if version files or branding assets have uncommitted changes
  DIRTY=$(git status --porcelain version.json package.json public/logo.svg public/logo.png public/badge.svg)
  if [ -n "$DIRTY" ]; then
    echo "❌ [pre-push] Detected uncommitted version or asset changes:"
    echo "$DIRTY"
    echo "   Please commit these changes before pushing (or run 'make bump')."
    exit 1
  fi
fi

exit 0
